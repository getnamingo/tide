{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}
{% set active_menu = 'order' %}

{% import "macro_functions.html.twig" as mf %}

{% set loader_nr = request.loader | default("8")%}
{% set loader_url = ('img/assets/loaders/loader'~loader_nr~'.gif') %}
{% set product = request.order ? guest.product_get({"id":request.order}) : null %}
{% set cart_currency = guest.cart_get_currency %}
{% if product is not defined or not product %}
    {% set product = request.product ? guest.product_get({"id":request.product}) : null %}
{% endif %}

{% set product_type = product.type|default('custom') %}

{% set product_type_labels = {
    'domain': 'Domains'|trans,
    'hosting': 'Web Hosting'|trans,
    'vps': 'VPS Hosting'|trans,
    'license': 'Software Licenses'|trans,
    'downloadable': 'Downloads'|trans,
    'addon': 'Add-ons'|trans,
    'custom': 'Services'|trans
} %}

{% set product_type_label = product_type_labels[product_type]|default('Services'|trans) %}

{% if product_type == 'domain' %}
    {% set product_page_title = 'Find your domain'|trans %}
{% else %}
    {% set product_page_title = product.title|default(product_type_label) %}
{% endif %}

{% block meta_title %}
    {% if request.order matches '/^\\d+$/' %}
        {% if product_type == 'domain' %}
            {{ 'Find your domain'|trans }}
        {% else %}
            {{ product.title|default(product_type_label) }} - {{ product_type_label }}
        {% endif %}

    {% elseif request.checkout matches '/^\\d+$/' %}
        {{ 'Cart'|trans }}

    {% else %}
        {{ 'Products'|trans }}
    {% endif %}
{% endblock %}

{% block body_class %}order-index{% endblock %}
{% block breadcrumb %}
        <li class="breadcrumb-item">
            <a href="{{ 'order'|url }}">
                {{ 'Order'|trans }}
            </a>
        </li>

    {% if request.order matches '/^\\d+$/' %}
        <li class="breadcrumb-item active" aria-current="page">
            {{ product_page_title }}
        </li>

    {% elseif request.checkout matches '/^\\d+$/' %}
        <li class="breadcrumb-item active" aria-current="page">
            {{ 'Cart'|trans }}
        </li>
    {% endif %}
{% endblock %}
{% block content_before %}{% endblock %}

{% block content %}
{% if request.order matches '/^\\d+$/' %}
<div class="row row-deck row-cards mb-3">
   <div class="col-md-12">
      <div class="card card-md">
        <div class="card-header py-3 py-3">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="mb-1">{{ product_page_title }}</h1>

                        {% if product_type != 'domain' %}
                            <span class="badge bg-primary-lt text-primary">
                                {{ product_type_label }}
                            </span>
                        {% endif %}
                    </div>

                    <span class="small text-muted">
                        {% if product_type == 'domain' %}
                            {{ 'Search for a new domain or transfer one you already own.'|trans }}
                        {% else %}
                            {{ 'Choose your billing cycle and available options.'|trans }}
                        {% endif %}
                    </span>
                </div>

                <div>
                    {% set cart = guest.cart_get %}
                    <a href="{{ 'orderbutton?checkout=1'|url }}" class="btn btn-light position-relative">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="svg-icon"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M15 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M17 17h-11v-14h-2" /><path d="M6 5l14 1l-1 7h-13" /></svg>&nbsp;{{ 'Cart'|trans }}
                        <span class="badge bg-green text-green-fg ms-1">
                            {{ cart.items | length }}
                        </span>
                    </a>
                </div>
            </div>
         </div>
         <div class="card-body">
            {% if product %}
            {% set add_item_redirect = 'orderbutton'|url({ 'checkout' : 1 }) ~ (request.show_custom_form_values ? '&show_custom_form_values=1' : '') %}
            <form method="post" action="{{ 'cart/add_item'|api_url(role: 'guest') }}" style="background:none;" class="form-{{ product.form_id ? guest.formbuilder_get( {"id":product.form_id}).style.type : 0 }}" {{ fb_api_form({message: 'Product Added to Shopping Cart'|trans, redirect: ('orderbutton'|url(query: { 'checkout' : 1 }) ~ (request.show_custom_form_values ? '&show_custom_form_values=1' : ''))}) }}>
                {% set product_details %}
                <div class="card card-borderless bg-primary-lt mb-4">
                  <div class="card-body">
                    <h3 class="card-title">{{ product.title }} <div class="card-subtitle">{% if product.description %}{{ (product.description ?? '')|markdown_to_html }}{% endif %}</div></h3>
                        <h5><strong>{{ 'Billing'|trans }}</strong></h5>
                        <div class="row">
                            <div class="col-12 col-md-4 col-xl-3">
                                {% if product.pricing.type is defined and product.pricing.type == 'recurrent' %}
                                <span>{{ 'Billing cycle'|trans }}</span>
                                {% else %}
                                <span>{{ 'One-time payment'|trans }}</span>
                                {% endif %}
                            </div>
                            <div class="col">
                                {% if product.pricing.type is defined and product.pricing.type == 'recurrent' %}
                                {% set periods = guest.system_periods %}
                                <select class="form-select" name="period" id="period-selector">
                                    {% for code,prices in product.pricing.recurrent %}
                                        {% if prices.enabled %}
                                            <option value="{{ code }}"{% if request.period == code %} selected="selected"{% endif %}>{{ (prices.price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }} ({{ periods[code] }})</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                                {% elseif product.pricing.type is defined and product.pricing.type == 'free' %}
                                <span class="badge bg-success text-success-fg">{{ 0|format_currency(cart_currency.code) }}</span>
                                {% else %}
                                    {% if product.pricing.once is defined and product.pricing.once.price is defined %}
                                        <span class="badge bg-success text-success-fg">{{ (product.pricing.once.price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</span>
                                    {% else %}
                                        <span class="badge bg-secondary text-secondary-fg">-</span>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                        {# TODO: This does not seem to be implemented on the back-end
                        {% if product.allow_quantity_select %}
                        <div class="row mt-3">
                            <div class="col-12 col-md-4 col-xl-3">
                                <span>{{ 'Quantity'|trans }}</span>
                            </div>
                            <div class="col">
                                <input type="number" name="quantity" value="1" min="1" class="form-control w-50" style="max-width: 120px; text-align: center;">
                            </div>
                        </div>
                        {% endif %}
                        #}
                  </div>
                </div>
                {% endset %}

                {% set tpl = "mod_service"~product.type~"_order_form.html.twig" %}
                {% if guest.system_template_exists({"file":tpl}) %}
                    {{ include(tpl, product) }}
                {% elseif product.form_id and guest.extension_is_on({"mod":"formbuilder"}) %}
                    {{ product_details }}
                    {% set form = guest.formbuilder_get({"id":product.form_id}) %}
                    {{ include('mod_formbuilder_build.html.twig', product) }}
                {% else %}
                    {{ product_details }}
                {% endif %}

                {{ include('mod_orderbutton_addons.html.twig', product) }}

                <input type="hidden" name="multiple" value="1" />
                <input type="hidden" name="id" value="{{ product.id }}" />
                <div class="mt-2 mb-0">
                    <button type="submit" class="btn btn-primary" id="config-next">{{ 'Next'|trans }}</button>
                </div>
            </form>
            {% endif %}
         </div>
      </div>
   </div>
</div>
{% endif %}
{% if request.checkout matches '/^\\d+$/' %}
{% set cart = guest.cart_get%}
{% set registration_domains = cart.items|filter(i => i.type == 'domain' and (i.action ?? '') == 'register') %}
{% if client %}
<div class="row row-deck row-cards mb-3">
   <div class="col-md-12">
      <div class="card">
        <div class="card-header py-3 py-3">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div>
                    <h1 class="mb-1">{{ 'Cart'|trans }}</h1>
                </div>
            </div>
        </div>
         <div class="card-body">
            {% if cart.items %}
            <div id="checkout">
               <div class="table-responsive" id="checkout-inner">
                  <table class="table table-striped table-bordered table-condensed">
                     <thead>
                        <tr>
                           <th>{{ 'Product'|trans }}</th>
                           <th>{{ 'Price'|trans }}</th>
                           <th style="width: 3%; text-align: center"></th>
                        </tr>
                     </thead>
                     <tbody>
                        {% for i, item in cart.items %}
                        <tr>
                           <td>
                              {{ item.title }}
                              {% if item.quantity > 1 %}
                              x {{ item.quantity }}
                              {% endif %}
                              {% if item.period|default(false) %}
                              ({{ item.period | period_title }})
                              {% endif %}
                           </td>
                           <td>
                              {% if item.discount_price %}
                              <del>{{ (item.total * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</del>
                              <strong class="text-success">{{ ((item.total-item.discount_price) * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong>
                              {% else %}
                              {{ (item.total * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}
                              {% endif %}
                           </td>
                           <td>
                               <a class="btn btn-outline-danger btn-icon" title="{{ 'Remove item'|trans }}"
                                  {{ fb_api_link({href: 'cart/remove_item'|api_url(query: {id: item.id}, role: 'guest'), modal: {type: 'confirm', title: 'Are you sure?'|trans, content: 'Are you sure you want to remove this item from cart?'|trans}, reload: true}) }}>
                                 <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                    <path d="M3 3m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"></path>
                                    <path d="M10 10l4 4m0 -4l-4 4"></path>
                                 </svg>
                               </a>
                           </td>
                        </tr>
                        {% if request.show_custom_form_values %}
                        <tr>
                           <td>
                              {% if item.form_id and guest.extension_is_on({"mod":"formbuilder"}) %}
                              {% set form = guest.formbuilder_get({"id": item.form_id}) %}
                              {# debug form #}
                              <div class="well">
                                 <dl class="dl-horizontal">
                                    {% for field, value in item %}
                                    {% for form_field in form.fields %}
                                    {% if value is not empty %}
                                    {% if form_field.name == field%}
                                    <dt>
                                       {{form_field.label}}
                                    </dt>
                                    <dd>
                                       {% if form_field.type == "checkbox"%}
                                       {% for selection in value %}
                                       {% for field_key,field_value in form_field.options%}
                                       {% if field_value == selection %}
                                       {{ field_key }}
                                       {% endif %}
                                       {% endfor %}
                                       {% endfor%}
                                       {% elseif form_field.type == "select" or form_field.type == "radio" %}
                                       {% for field_key,field_value in form_field.options%}
                                       {% if field_value == value %}
                                       {{ field_key }}
                                       {% endif %}
                                       {% endfor %}
                                       {% else %}
                                       {{value}}
                                       {% endif %}
                                    </dd>
                                    {% endif %}
                                    {% endif %}
                                    {% endfor %}
                                    {% endfor %}
                                 </dl>
                              </div>
                              {% endif %}
                           </td>
                           <td></td>
                        </tr>
                        {% endif %}
                        {% if item.setup_price != 0 %}
                        <tr>
                           <td>{{ item.title }} {{ 'setup'|trans }}</td>
                           <td>
                              {% if item.discount_setup %}
                              <del>{{ (item.setup_price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</del>
                              {{ ((item.setup_price - item.discount_setup) * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}
                              {% else %}
                              {{ (item.setup_price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}
                           </td>
                           {% endif %}
                        </tr>
                        {% endif %}
                        {% endfor %}
                     </tbody>
                  </table>
               </div>
               {% if not cart.promocode %}
               <div class="mb-3 mt-3">
                  <a href="#" id="show-promo-field">{{ 'Have a coupon code?'|trans }}</a>
               </div>
               {% endif %}
               <form method="post" action="{{ 'cart/apply_promo'|api_url(role: 'guest') }}" {{ fb_api_form({message: 'Promo Code Applied to Order'|trans, reload: true}) }} {% if not cart.promocode %}style="display:none"{% endif %} id="apply-promo">
                    <div class="mb-3">
                        <div class="row">
                            <div class="col-8 col-md-8">
                                <input class="form-control" type="text" name="promocode" id="promocode" value="{{ request.promocode|default(cart.promocode) }}" {% if promo|default({}).required|default(false) %}required="required"{% endif %} placeholder="{{ 'Enter code'|trans }}">
                            </div>
                            <div class="col-4 col-md-4">
                                {% if cart.promocode %}
                                    <a class="btn btn-warning btn-sm mb-1" href="{{ 'cart/remove_promo'|api_url(role: 'guest') }}" type="button" {{ fb_api_link({reload: true}) }}><svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                   <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                   <path d="M12 8h8a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-4m-4 0h-8a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1h4"></path>
                                   <path d="M12 12v9"></path>
                                   <path d="M19 12v3m0 4a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-7"></path>
                                   <path d="M7.5 8a2.5 2.5 0 0 1 -2.457 -2.963m2.023 -2c.14 -.023 .286 -.037 .434 -.037c1.974 -.034 3.76 1.95 4.5 5c.74 -3.05 2.526 -5.034 4.5 -5a2.5 2.5 0 1 1 0 5"></path>
                                   <path d="M3 3l18 18"></path>
                                </svg> {{ 'Remove'|trans }}</a>
                                {% else %}
                                    <button class="btn btn-secondary mb-1" type="submit">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                       <path d="M3 8m0 1a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1z"></path>
                                       <path d="M12 8l0 13"></path>
                                       <path d="M19 12v7a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-7"></path>
                                       <path d="M7.5 8a2.5 2.5 0 0 1 0 -5a4.8 8 0 0 1 4.5 5a4.8 8 0 0 1 4.5 -5a2.5 2.5 0 0 1 0 5"></path>
                                    </svg>
                                    {{ 'Apply'|trans }}</button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
               </form>
               <div class="table-responsive">
                  <table class="table table-bordered table-striped">
                     {% if cart.discount >0 %}
                     <tr>
                        <td><strong>{{ 'Subtotal:'|trans }}</strong></td>
                        <td><strong>{{ (cart.subtotal * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong></td>
                     </tr>
                     <tr>
                        <td><strong>{{ 'Discount:'|trans }}</strong></td>
                        <td><strong>- {{ (cart.discount * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong></td>
                     </tr>
                     {% endif %}
                     {% set tax_amount = 0 %}
                     {% if client.client_is_taxable %}
                     {% set tax_rate = client.invoice_get_tax_rate %}
                     {% set tax_amount = cart.total * tax_rate / 100 %}
                     <tr>
                        <td><strong>{{ 'VAT'|trans }} ({{ tax_rate }}%) :</strong></td>
                        <td><strong>{{ (tax_amount * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong></td>
                     </tr>
                     {% endif %}
                     <tr>
                        <td><strong>{{ 'Total:'|trans }}</strong></td>
                        <td><strong>{{ ((cart.total + tax_amount) * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</strong></td>
                     </tr>
                  </table>
               </div>
               <form method="post" action="{{ 'cart/checkout'|api_url }}" {{ fb_api_form({callback: 'onOrderCheckout'}) }}>
                  {% if registration_domains|length > 0 %}
                  {% set registration_domain = registration_domains|first %}
                  {% set has_custom_ns =
                      (registration_domain.ns1 ?? '')|trim or
                      (registration_domain.ns2 ?? '')|trim or
                      (registration_domain.ns3 ?? '')|trim or
                      (registration_domain.ns4 ?? '')|trim
                  %}
                  <div class="row g-3 mt-1">
                     <div class="col-12 col-lg-6">
                        <div class="card h-100">
                           <div class="card-body">
                              <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                 <div>
                                    <h3 class="card-title mb-1">{{ 'Registrant contact'|trans }}</h3>
                                    <div class="text-muted small">{{ 'These details will be used for your new domain registration.'|trans }}</div>
                                 </div>
                                 {% if profile is defined and profile and (profile.id ?? 0) %}
                                 <a href="{{ 'client/profile'|url }}" target="_blank" class="btn btn-sm btn-outline-primary text-nowrap">
                                    {{ 'Update profile'|trans }}
                                 </a>
                                 {% endif %}
                              </div>

                              {% if profile is defined and profile and (profile.id ?? 0) %}
                              <div class="d-flex flex-column gap-2">
                                 <div class="fw-semibold">
                                    {{ ((profile.first_name ?? '') ~ ' ' ~ (profile.last_name ?? ''))|trim ?: '---' }}
                                    {% set doc = (profile.document_nr ?? '')|trim %}
                                    {% if doc %}
                                    <span class="text-muted small fw-normal">({{ 'ID'|trans }}: {{ doc }})</span>
                                    {% endif %}
                                 </div>

                                 {% set company = (profile.company ?? '')|trim %}
                                 {% set companyNr = (profile.company_number ?? '')|trim %}
                                 {% if company or companyNr %}
                                 <div>
                                    {{ company ?: '---' }}
                                    {% if companyNr %}<span class="text-muted small">({{ 'No.'|trans }} {{ companyNr }})</span>{% endif %}
                                 </div>
                                 {% endif %}

                                 <div class="row g-2">
                                    <div class="col-sm-6">
                                       <div class="text-muted small">{{ 'Email'|trans }}</div>
                                       <div>{{ (profile.email ?? '')|trim ?: '---' }}</div>
                                    </div>
                                    <div class="col-sm-6">
                                       <div class="text-muted small">{{ 'Phone'|trans }}</div>
                                       {% set phone = (profile.phone ?? '')|trim %}
                                       {% set cc = (profile.phone_cc ?? '')|trim %}
                                       <div>{{ phone ? ('+' ~ (cc ?: '') ~ ' ' ~ phone)|trim : '---' }}</div>
                                    </div>
                                 </div>

                                 <div>
                                    <div class="text-muted small">{{ 'Address'|trans }}</div>
                                    {% set a1 = (profile.address_1 ?? '')|trim %}
                                    {% set a2 = (profile.address_2 ?? '')|trim %}
                                    {% set city = (profile.city ?? '')|trim %}
                                    {% set state = (profile.state ?? '')|trim %}
                                    {% set pc = (profile.postcode ?? '')|trim %}
                                    {% set country = (profile.country ?? '')|trim %}
                                    <div class="small">
                                       <div>{{ a1 ?: '---' }}</div>
                                       {% if a2 %}<div>{{ a2 }}</div>{% endif %}
                                       <div>{{ [pc, city]|filter(v => v is not empty)|join(' ') ?: '---' }}{% if state %}, {{ state }}{% endif %}</div>
                                       {% if country %}<div>{{ country }}</div>{% endif %}
                                    </div>
                                 </div>
                              </div>
                              {% else %}
                              <div class="text-muted">{{ 'Your current client profile will be used for the registration.'|trans }}</div>
                              {% endif %}
                           </div>
                        </div>
                     </div>

                     <div class="col-12 col-lg-6">
                        <div class="card h-100">
                           <div class="card-body">
                              <h3 class="card-title mb-1">{{ 'Nameservers'|trans }}</h3>
                              <div class="text-muted small mb-3">{{ 'This choice applies to all new domain registrations in this cart.'|trans }}</div>

                              <select class="form-select" id="checkout-ns-mode" name="domain_ns_mode">
                                 <option value="default"{% if not has_custom_ns %} selected{% endif %}>{{ 'Default nameservers'|trans }}</option>
                                 <option value="custom"{% if has_custom_ns %} selected{% endif %}>{{ 'Custom nameservers'|trans }}</option>
                              </select>

                              <div id="checkout-ns-default-hint" class="text-muted mt-3">
                                 {{ 'We will use the default nameservers. You can change them later from your client area.'|trans }}
                              </div>

                              <div id="checkout-ns-custom-fields" class="mt-3 d-none">
                                 <div class="row g-2">
                                    <div class="col-12 col-md-6">
                                       <input type="text" class="form-control" name="domain_ns1" value="{{ registration_domain.ns1 ?? '' }}" placeholder="{{ 'Nameserver 1'|trans }}" autocapitalize="off">
                                    </div>
                                    <div class="col-12 col-md-6">
                                       <input type="text" class="form-control" name="domain_ns2" value="{{ registration_domain.ns2 ?? '' }}" placeholder="{{ 'Nameserver 2'|trans }}" autocapitalize="off">
                                    </div>
                                    <div class="col-12 col-md-6">
                                       <input type="text" class="form-control" name="domain_ns3" value="{{ registration_domain.ns3 ?? '' }}" placeholder="{{ 'Nameserver 3'|trans }}" autocapitalize="off">
                                    </div>
                                    <div class="col-12 col-md-6">
                                       <input type="text" class="form-control" name="domain_ns4" value="{{ registration_domain.ns4 ?? '' }}" placeholder="{{ 'Nameserver 4'|trans }}" autocapitalize="off">
                                    </div>
                                 </div>
                              </div>
                           </div>
                        </div>
                     </div>
                  </div>
                  {% endif %}

                  <div class="card mt-3">
                    <div class="card-body">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="agreeTerms" name="agree_terms" required>
                        <label class="form-check-label" for="agreeTerms">
                          {{ 'Before completing your order, you must agree to the following documents:'|trans }}
                        </label>
                      </div>
                      {% set has_ge = cart.items|filter(i => i.type == 'domain' and (i.register_tld == '.ge' or i.transfer_tld == '.ge'))|length > 0 %}

                      <div class="mt-2 small">
                        <div class="mt-3">
                          <div class="card card-sm mb-2 border">
                            <div class="card-body d-flex align-items-center justify-content-between">
                              <div class="d-flex align-items-center">
                                <span class="avatar avatar-sm bg-blue-lt me-3">
