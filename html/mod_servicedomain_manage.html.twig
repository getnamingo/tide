{% block js %}
<script src="{{ 'libs/intl-tel-input/dist/js/intlTelInputWithUtils.min.js'|asset_url }}"></script>
<script>
window.onRenewalInvoiceCreated = (hash) => {
    window.location = "{{ 'invoice'|url }}/" + hash;
};

const DOMAIN_LOCKED_TEXT    = "{{ 'Locked'|trans }}";
const DOMAIN_UNLOCKED_TEXT  = "{{ 'Unlocked'|trans }}";
const PRIVACY_ENABLED_TEXT  = "{{ 'Enabled'|trans }}";
const PRIVACY_DISABLED_TEXT = "{{ 'Disabled'|trans }}";

const TXT_REVEAL  = "{{ 'Reveal'|trans }}";
const TXT_LOADING = "{{ 'Loading...'|trans }}";
const TXT_COPY    = "{{ 'Copy'|trans }}";
const TXT_COPIED  = "{{ 'Copied'|trans }}";
const TXT_FAILED  = "{{ 'Failed'|trans }}";
const MASKED_EPP  = "••••••••••••";

let eppHideTimer = null;

function resetEppUI() {
    const value = document.getElementById('epp-code-value');
    const btn   = document.getElementById('epp-code-reveal');

    value.textContent = MASKED_EPP;
    value.classList.add('text-muted');
    value.classList.remove('fw-bold', 'text-body');

    btn.disabled = false;
    btn.classList.remove('btn-outline-success');
    btn.classList.add('btn-outline-secondary');
    btn.textContent = TXT_REVEAL;

    delete btn.dataset.epp;
}

function scheduleEppHide() {
    if (eppHideTimer) clearTimeout(eppHideTimer);
    eppHideTimer = setTimeout(resetEppUI, 30000); // 30 sec
}

function setLockBadge(isLocked) {
    const b = document.getElementById('domain-lock-badge');

    b.classList.toggle('bg-green-lt', isLocked);
    b.classList.toggle('text-green', isLocked);

    b.classList.toggle('bg-yellow-lt', !isLocked);
    b.classList.toggle('text-yellow', !isLocked);

    b.textContent = isLocked ? DOMAIN_LOCKED_TEXT : DOMAIN_UNLOCKED_TEXT;
}

function setPrivacyBadge(isEnabled) {
    const b = document.getElementById('domain-privacy-badge');

    b.classList.toggle('bg-green-lt', isEnabled);
    b.classList.toggle('text-green', isEnabled);

    b.classList.toggle('bg-secondary-lt', !isEnabled);
    b.classList.toggle('text-secondary', !isEnabled);

    b.textContent = isEnabled ? PRIVACY_ENABLED_TEXT : PRIVACY_DISABLED_TEXT;
}

function toggleDisplay(idA, idB) {
    const a = document.getElementById(idA);
    const b = document.getElementById(idB);

    a.style.display = (a.style.display === 'none') ? '' : 'none';
    b.style.display = (b.style.display === 'none') ? '' : 'none';
}

function apiFailToast(err) {
    let msg = TXT_FAILED;
    if (typeof err === 'string' && err.trim()) msg = err.trim();
    else if (err && typeof err === 'object') {
        const maybe = err.message || err.error || err.msg;
        if (typeof maybe === 'string' && maybe.trim()) msg = maybe.trim();
    }
    FOSSBilling.message(msg);
}

document.getElementById('domain-lock').addEventListener('click', function (event) {
    event.preventDefault();

    FOSSBilling.api.client.post(
        'servicedomain/lock',
        { order_id: {{ order.id }} },
        () => {
            toggleDisplay('domain-lock', 'domain-unlock');
            setLockBadge(true);
        },
        (err) => apiFailToast(err)
    );
});

document.getElementById('domain-unlock').addEventListener('click', function (event) {
    event.preventDefault();

    FOSSBilling.api.client.post(
        'servicedomain/unlock',
        { order_id: {{ order.id }} },
        () => {
            toggleDisplay('domain-lock', 'domain-unlock');
            setLockBadge(false);
        },
        (err) => apiFailToast(err)
    );
});

document.getElementById('domain-enable-pp').addEventListener('click', function (event) {
    event.preventDefault();

    FOSSBilling.api.client.post(
        'servicedomain/enable_privacy_protection',
        { order_id: {{ order.id }} },
        () => {
            toggleDisplay('domain-enable-pp', 'domain-disable-pp');
            setPrivacyBadge(true);
        },
        (err) => apiFailToast(err)
    );
});

document.getElementById('domain-disable-pp').addEventListener('click', function (event) {
    event.preventDefault();

    FOSSBilling.api.client.post(
        'servicedomain/disable_privacy_protection',
        { order_id: {{ order.id }} },
        () => {
            toggleDisplay('domain-enable-pp', 'domain-disable-pp');
            setPrivacyBadge(false);
        },
        (err) => apiFailToast(err)
    );
});

document.getElementById('domain-sync').addEventListener('click', function (event) {
    event.preventDefault();

    const btn = this;
    btn.disabled = true;

    FOSSBilling.api.client.post(
        'servicedomain/sync',
        { order_id: {{ order.id }} },
        () => {
            window.location.reload();
        },
        (err) => {
            btn.disabled = false;
            apiFailToast(err);
        }
    );
});

{% if dns_order %}
function formatLinkedDsRecord(record) {
    if (typeof record === 'string') {
        return record;
    }

    if (record && typeof record === 'object') {
        const keyTag = record.key_tag ?? record.keytag ?? record.keyTag;
        const algorithm = record.algorithm;
        const digestType = record.digest_type ?? record.digestType;
        const digest = record.digest;

        if (
            keyTag !== undefined &&
            algorithm !== undefined &&
            digestType !== undefined &&
            digest !== undefined
        ) {
            return `${keyTag} ${algorithm} ${digestType} ${digest}`;
        }
    }

    return String(record);
}

function loadLinkedDnssec() {
    FOSSBilling.api.client.post(
        'servicedns/dnssec',
        { order_id: {{ dns_order.id }} },
        (result) => {
            if (!result || !result.supported) {
                return;
            }

            const badge = document.getElementById('linked-dnssec-status');

            badge.textContent = result.enabled
                ? "{{ 'Enabled'|trans|e('js') }}"
                : "{{ 'Disabled'|trans|e('js') }}";

            badge.className = result.enabled
                ? 'badge bg-green-lt text-green'
                : 'badge bg-red-lt text-red';

            document.getElementById('linked-dnssec-item').style.display = '';

            const section = document.getElementById('linked-dnssec-ds-section');
            const container = document.getElementById('linked-dnssec-ds');

            container.replaceChildren();

            const records = Array.isArray(result.ds) ? result.ds : [];

            if (!result.enabled || !records.length) {
                section.classList.add('d-none');
                return;
            }

            records.forEach((record) => {
                const value = formatLinkedDsRecord(record);

                const row = document.createElement('div');
                row.className = 'd-flex align-items-center justify-content-between gap-2 mb-2';

                const code = document.createElement('code');
                code.className = 'text-body text-break';
                code.textContent = value;

                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'btn btn-sm btn-outline-secondary';
                button.textContent = "{{ 'Copy'|trans|e('js') }}";

                button.addEventListener('click', () => {
                    navigator.clipboard.writeText(value);
                });

                row.appendChild(code);
                row.appendChild(button);
                container.appendChild(row);
            });

            section.classList.remove('d-none');
        }
    );
}
{% endif %}

document.addEventListener("DOMContentLoaded", function () {
    const domainPanels = ['nameservers', 'glue-hosts', 'dnssec', 'dns-hosting'];
    const domainPanelButtons = Array.from(
        document.querySelectorAll('[data-domain-panel]')
    );

    function selectDomainPanel(panelId) {
        domainPanels.forEach((id) => {
            const panel = document.getElementById(id);
            if (panel) {
                panel.classList.toggle('d-none', id !== panelId);
            }
        });

        domainPanelButtons.forEach((button) => {
            const selected = button.dataset.domainPanel === panelId;
            button.classList.toggle('btn-secondary', selected);
            button.classList.toggle('btn-outline-secondary', !selected);
        });
    }

    domainPanelButtons.forEach((button) => {
        button.addEventListener('click', () => {
            selectDomainPanel(button.dataset.domainPanel);
        });
    });

    const dnsHostingAvailable = {{ dns_order ? 'true' : 'false' }};

    if (dnsHostingAvailable) {
        document.getElementById('domain-settings-switcher')
            .classList.remove('d-none');
    }

    {% if domainx_enabled %}
    const dnssecCard = document.getElementById('dnssec');
    const dnssecButton = document.getElementById('domain-panel-dnssec-button');
    const dnssecTable = document.getElementById('dnssec-current');
    const dnssecBody = document.getElementById('dnssec-records');
    const dnssecEmpty = document.getElementById('dnssec-empty');
    const dnssecLimit = document.getElementById('dnssec-limit');
    const dnssecForm = document.getElementById('dnssec-add-form');
    const glueCard = document.getElementById('glue-hosts');
    const glueButton = document.getElementById('domain-panel-glue-button');
    const glueForm = document.getElementById('glue-form');
    const glueHostname = document.getElementById('glue-hostname');
    const glueIp = document.getElementById('glue-ip-address');
    const glueCurrentIp = document.getElementById('glue-current-ip');
    const glueNewIp = document.getElementById('glue-new-ip');
    const glueSubmit = document.getElementById('glue-submit');
    const glueLookup = document.getElementById('glue-lookup');
    const glueInfo = document.getElementById('glue-info');
    const glueAddresses = document.getElementById('glue-addresses');
    const glueActions = Array.from(glueCard.querySelectorAll('[data-glue-action]'));
    let glueAction = 'create';

    function selectGlueAction(action) {
        glueAction = action;
        glueActions.forEach((button) => {
            const selected = button.dataset.glueAction === action;
            button.classList.toggle('btn-secondary', selected);
            button.classList.toggle('btn-outline-secondary', !selected);
            button.setAttribute('aria-pressed', String(selected));
            if (selected) glueSubmit.textContent = button.textContent.trim();
        });
        document.getElementById('glue-create-fields').classList.toggle('d-none', action !== 'create');
        document.getElementById('glue-update-fields').classList.toggle('d-none', action !== 'update');
        document.getElementById('glue-delete-note').classList.toggle('d-none', action !== 'delete');
        glueIp.required = action === 'create';
        glueInfo.classList.add('d-none');
    }

    glueActions.forEach((button) => {
        button.addEventListener('click', () => selectGlueAction(button.dataset.glueAction));
    });
    glueHostname.addEventListener('input', () => glueInfo.classList.add('d-none'));

    function loadGlueAddresses() {
        if (!glueHostname.reportValidity()) return;
        const hostname = glueHostname.value.trim();
        glueLookup.disabled = true;
        glueInfo.classList.add('d-none');

        FOSSBilling.api.client.post(
            'domainx/glue_info',
            { order_id: {{ order.id }}, hostname: hostname },
            (result) => {
                glueLookup.disabled = false;
                if (glueAction !== 'update' || glueHostname.value.trim() !== hostname) return;

                glueAddresses.replaceChildren();
                const addresses = result && Array.isArray(result.ip_addresses) ? result.ip_addresses : [];
                addresses.forEach((address) => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'btn btn-sm btn-outline-secondary font-monospace';
                    button.textContent = String(address) + ' · ' + glueCard.dataset.currentText;
                    button.addEventListener('click', () => { glueCurrentIp.value = String(address); });
                    glueAddresses.appendChild(button);
                });
                if (!addresses.length) {
                    glueAddresses.textContent = glueCard.dataset.noAddresses;
                }
                glueInfo.classList.remove('d-none');
            },
            (err) => {
                glueLookup.disabled = false;
                apiFailToast(err);
            }
        );
    }

    glueLookup.addEventListener('click', loadGlueAddresses);

    glueForm.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!glueForm.reportValidity()) return;

        const action = glueAction;
        const data = { order_id: {{ order.id }}, hostname: glueHostname.value.trim() };
        if (action === 'create') {
            data.ip_address = glueIp.value.trim();
        } else if (action === 'update') {
            const currentIp = glueCurrentIp.value.trim();
            const newIp = glueNewIp.value.trim();
            if (!currentIp && !newIp) {
                FOSSBilling.message(glueCard.dataset.addressRequired);
                return;
            }
            if (currentIp) data.current_ip_address = currentIp;
            if (newIp) data.new_ip_address = newIp;
        } else if (!window.confirm(glueCard.dataset.confirmText + '\n\n' + data.hostname)) {
            return;
        }

        glueSubmit.disabled = true;
        FOSSBilling.api.client.post(
            'domainx/glue_' + action,
            data,
            () => {
                glueSubmit.disabled = false;
                const messages = {
                    create: glueCard.dataset.createdText,
                    update: glueCard.dataset.updatedText,
                    delete: glueCard.dataset.deletedText
                };
                FOSSBilling.message(messages[action]);
                glueInfo.classList.add('d-none');
                if (action === 'create') glueIp.value = '';
                if (action === 'update') {
                    glueCurrentIp.value = '';
                    glueNewIp.value = '';
                }
                if (action === 'delete') glueHostname.value = '';
            },
            (err) => {
                glueSubmit.disabled = false;
                apiFailToast(err);
            }
        );
    });

    function appendDnssecCell(row, value, className) {
        const cell = document.createElement('td');

        if (className) {
            cell.className = className;
        }

        cell.textContent = String(value);
        row.appendChild(cell);
    }

    function removeDnssecRecord(record, button) {
        if (!window.confirm(dnssecCard.dataset.deleteConfirm)) {
            return;
        }

        button.disabled = true;

        FOSSBilling.api.client.post(
            'domainx/dnssec_update',
            {
                order_id: {{ order.id }},
                command: 'rem',
                key_tag: record.key_tag,
                algorithm: record.algorithm,
                digest_type: record.digest_type,
                digest: record.digest
            },
            () => {
                FOSSBilling.message(dnssecCard.dataset.removedText);
                loadDomainxCapabilities();
            },
            (err) => {
                button.disabled = false;
                apiFailToast(err);
            }
        );
    }

    function renderDnssecRecords(feature) {
        const records = Array.isArray(feature.records)
            ? feature.records
            : [];

        {% if not dns_order %}
        const dnssecEnabled = records.length > 0;
        const badge = document.getElementById('linked-dnssec-status');

        badge.textContent = dnssecEnabled
            ? "{{ 'Enabled'|trans|e('js') }}"
            : "{{ 'Disabled'|trans|e('js') }}";

        badge.className = dnssecEnabled
            ? 'badge bg-green-lt text-green'
            : 'badge bg-red-lt text-red';

        document.getElementById('linked-dnssec-item').style.display = '';
        {% endif %}

        const maxRecords = Number(feature.max_records || 2);

        dnssecBody.replaceChildren();

        records.forEach((record) => {
            const row = document.createElement('tr');

            appendDnssecCell(row, record.key_tag);
            appendDnssecCell(row, record.algorithm);
            appendDnssecCell(row, record.digest_type);
            appendDnssecCell(
                row,
                record.digest,
                'font-monospace small text-break'
            );

            const actions = document.createElement('td');
            actions.className = 'text-end';

            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'btn btn-sm btn-outline-danger';
            button.textContent = dnssecCard.dataset.deleteText;
            button.addEventListener('click', () => {
                removeDnssecRecord(record, button);
            });

            actions.appendChild(button);
            row.appendChild(actions);
            dnssecBody.appendChild(row);
        });

        dnssecTable.classList.toggle('d-none', records.length === 0);
        dnssecEmpty.classList.toggle('d-none', records.length !== 0);
        dnssecForm.classList.toggle(
            'd-none',
            records.length >= maxRecords
        );
        dnssecLimit.classList.toggle(
            'd-none',
            records.length < maxRecords
        );
    }

    function loadDomainxCapabilities() {
        FOSSBilling.api.client.post(
            'domainx/capabilities',
            {
                order_id: {{ order.id }}
            },
            (result) => {
                const features = result && result.features || {};
                const feature = features.dnssec;
                const glueAvailable = !!(features.glue && features.glue.available);
                const dnssecAvailable = !!(feature && feature.available);

                glueButton.classList.toggle('d-none', !glueAvailable);
                dnssecButton.classList.toggle('d-none', !dnssecAvailable);

                document.getElementById('domain-settings-switcher')
                .classList.toggle(
                    'd-none',
                    !glueAvailable && !dnssecAvailable && !dnsHostingAvailable
                );

                if (!glueAvailable) {
                    glueCard.classList.add('d-none');
                    if (glueButton.classList.contains('btn-secondary')) {
                        selectDomainPanel('nameservers');
                    }
                }

                if (!dnssecAvailable) {
                    dnssecCard.classList.add('d-none');
                    if (dnssecButton.classList.contains('btn-secondary')) {
                        selectDomainPanel('nameservers');
                    }
                    return;
                }

                renderDnssecRecords(feature);
            },
            () => {
                dnssecButton.classList.add('d-none');
                glueButton.classList.add('d-none');
                if (!dnsHostingAvailable) {
                    document.getElementById('domain-settings-switcher')
                        .classList.add('d-none');
                }
                selectDomainPanel('nameservers');
            }
        );
    }

    window.domainxDnssecAdded = function () {
        FOSSBilling.message(dnssecCard.dataset.addedText);
        dnssecForm.reset();
        loadDomainxCapabilities();
    };

    loadDomainxCapabilities();
    {% endif %}

    {% if dns_order %}
    loadLinkedDnssec();
    {% endif %}
});

document.getElementById('epp-code-reveal').addEventListener('click', function (event) {
    event.preventDefault();

    const btn   = this;
    const value = document.getElementById('epp-code-value');

    btn.disabled = true;
    btn.textContent = TXT_LOADING;

    FOSSBilling.api.client.post(
        'servicedomain/get_transfer_code',
        { order_id: {{ order.id }} },
        (result) => {
            const code = (typeof result === 'string' && result.trim()) ? result.trim() : '************';

            value.textContent = code;
            value.classList.remove('text-muted');
            value.classList.add('fw-bold', 'text-body');

            Promise.resolve(navigator.clipboard && navigator.clipboard.writeText
                ? navigator.clipboard.writeText(code)
                : Promise.reject(new Error('Clipboard not available')))
                .then(() => {
                    btn.textContent = TXT_COPIED;
                    btn.classList.remove('btn-outline-secondary');
                    btn.classList.add('btn-outline-success');
                })
                .catch(() => {
                    btn.textContent = TXT_COPY;
                })
                .finally(() => {
                    btn.disabled = false;
                    scheduleEppHide();
                });
        },
        (err) => {
            apiFailToast(err);
            btn.disabled = false;
            btn.textContent = TXT_FAILED;
            setTimeout(() => { btn.textContent = TXT_REVEAL; }, 1500);
        }
    );
});
</script>
