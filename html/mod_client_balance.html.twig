{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'Wallet'|trans }}{% endblock %}

{% block breadcrumb %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Wallet'|trans }}</li>
{% endblock %}

{% set profile = client.profile_get %}

{% block body_class %}client-balance{% endblock %}

{% block content %}
    {% set transactions = client.client_balance_get_list({
        "per_page": 10,
        "page": request.page
    }) %}

    <div class="row">
        <div class="col-12">
            <div class="card mb-4">

                <div class="card-header py-3">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 w-100">
                        <div>
                            <h1 class="mb-1">{{ 'Wallet'|trans }}</h1>
                            <span class="small text-muted">
                                {{ 'Here you can manage and track your account balance.'|trans }}
                            </span>
                        </div>

                        {% if guest.invoice_funds_enabled %}
                            <form
                                method="post"
                                class="d-flex gap-2 ms-md-auto"
                                action="{{ 'invoice/funds_invoice'|api_url }}"
                                {{ fb_api_form({callback: 'onAfterInvoiceCreated'}) }}
                            >
                                <div class="input-group" style="max-width: 220px;">
                                    <input
                                        id="appendedPrependedInput"
                                        class="form-control"
                                        type="text"
                                        name="amount"
                                        placeholder="0"
                                        inputmode="decimal"
                                        required
                                    >

                                    <span class="input-group-text">
                                        {{ profile.currency ?? default_currency }}
                                    </span>
                                </div>

                                <button class="btn btn-primary text-nowrap" type="submit">
                                    {{ 'Add Funds'|trans }}
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>

                {% if transactions.list %}
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-hover">
                            <thead>
                                <tr>
                                    <th>{{ 'Description'|trans }}</th>
                                    <th>{{ 'Date'|trans }}</th>
                                    <th class="text-end">{{ 'Amount'|trans }}</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for i, tx in transactions.list %}
                                    <tr>
                                        {# Description #}
                                        <td>
                                            <span class="fw-medium">
                                                {{ tx.description }}
                                            </span>
                                        </td>

                                        {# Date #}
                                        <td class="text-muted text-nowrap">
                                            {{ tx.created_at|format_date }}
                                        </td>

                                        {# Amount #}
                                        <td class="text-end text-nowrap">

                                            <span class="fw-semibold
                                                {% if tx.amount > 0 %}
                                                    text-success
                                                {% elseif tx.amount < 0 %}
                                                    text-danger
                                                {% endif %}
                                            ">
                                                {{ tx.amount|format_currency(
                                                    tx.currency ?? default_currency
                                                ) }}
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>

                            <tfoot>
                                <tr>
                                    <td colspan="2" class="fw-medium">
                                        {{ 'Total'|trans }}
                                    </td>

                                    <td class="text-end">
                                        <span class="fw-bold">
                                            {{ profile.balance|format_currency(
                                                profile.currency ?? default_currency
                                            ) }}
                                        </span>
                                    </td>
                                </tr>
                            </tfoot>

                        </table>
                    </div>

                    {% if transactions.pages > 1 %}
                        <div class="card-footer d-flex justify-content-end">
                            {{ include('partial_pagination.html.twig', {
                                'list': transactions,
                                'url': 'client/balance'
                            }) }}
                        </div>
                    {% endif %}

                {% else %}
                    <div class="card-body">
                        <div class="d-flex justify-content-center my-2 py-4">
                            <span class="m-0">
                                {{ 'The list is empty'|trans }}
                            </span>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block js %}
<script>
    function onAfterInvoiceCreated(hash) {
        window.location = '{{ "invoice"|url }}/' + hash;
    }
</script>
{% endblock %}