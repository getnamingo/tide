{% if order.status == 'active' %}
<div class="card border-0 shadow-none">
    <div class="card-header py-3">
      <div class="d-flex justify-content-between align-items-start gap-2 flex-nowrap w-100">
        <div class="flex-fill">
          <h1 class="mb-1">Hosting: {{ service.domain }}</h1>
          {% if order.period and order.expires_at %}
            {% set days_left = order.expires_at|daysleft %}
            {% set renewal_color = days_left <= 7 ? 'danger' : (days_left <= 30 ? 'orange' : 'primary') %}
            <div class="d-flex align-items-center gap-2 small text-secondary">
              <span>
                {{ 'Renews on'|trans }}
                <strong>{{ order.expires_at|date('Y-m-d') }}</strong>
                {{ 'for'|trans }}
                <strong>{{ order.total|format_currency(order.currency ?? default_currency) }}</strong>
              </span>
              <span class="badge d-none d-sm-inline bg-{{ renewal_color }}-lt text-{{ renewal_color }}">
                {{ days_left }} {{ 'days left'|trans }}
              </span>
            </div>
          {% else %}
            <span class="small text-secondary">{{ 'Hosting plan details'|trans }}</span>
          {% endif %}
        </div>

        {% if order.period and order.status != 'failed_renew' %}
          <div class="ms-auto flex-shrink-0 align-self-center">
            <a class="btn btn-outline btn-{{ renewal_color }} px-2 px-sm-3 text-nowrap"
               {{ fb_api_link({
                 href: 'invoice/renewal_invoice'|api_url(query: {order_id: order.id}),
                 modal: {
                   type: 'confirm',
                   title: 'Are you sure?'|trans,
                   content: 'This will generate new invoice. Are you sure you want to continue?'|trans
                 },
                 callback: 'onRenewalInvoiceCreated'
               }) }}>
              {{ 'Renew Now'|trans }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
    <div class="card-body">
      <div class="row row-cards mb-6">
      {% set server = service.server %}
      {% set hp = service.hosting_plan %}
        <div class="col-12 col-lg-6 mb-3 mb-lg-0">
          <div class="card">
            <div class="card-header">
              <h2 class="card-title">{{ 'Server'|trans }}</h2>
            </div>
            <div class="card-body">
              <dl class="row">
                <dt class="col-5">{{ 'Server IP'|trans }}:</dt>
                <dd class="col-7">{{ server.ip }}</dd>

                <dt class="col-5">{{ 'Server Hostname'|trans }}:</dt>
                <dd class="col-7">{{ server.hostname }}</dd>

                <dt class="col-5">{{ 'Username'|trans }}:</dt>
                <dd class="col-7">{{ service.username }}</dd>
              </dl>
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-6">
          <div class="card">
            <div class="card-header">
              <h2 class="card-title">{{ 'Hosting'|trans }} <span class="card-subtitle">{{ 'Created'|trans }}: {{ order.created_at|date('Y-m-d') }}</span></h2>
            </div>
            <div class="card-body">
              <dl class="row">
                <dt class="col-5">{{ 'Hosting Plan'|trans }}:</dt>
                <dd class="col-7">{{ hp.name }}</dd>

                <dt class="col-5">{{ 'Bandwidth'|trans }}:</dt>
                <dd class="col-7">{% if hp.bandwidth == 'unlimited' %}{{ 'Unlimited'|trans }}{% else %}{{ hp.bandwidth }} MB / {{ 'per month'|trans }}{% endif %}</dd>

                <dt class="col-5">{{ 'Disk Quota'|trans }}:</dt>
                <dd class="col-7">{% if hp.quota == 'unlimited' %}{{ 'Unlimited'|trans }}{% else %}{{ hp.quota }} MB{% endif %}</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <div class="row row-cards mb-6">
        <div class="col-12 d-flex justify-content-center gap-2">
          {% if service.domain_order_id %}
            <a class="btn btn-l btn-outline-primary" href='{{ "order/service/manage/#{service.domain_order_id}"|url }}'>{{ 'Manage Domain'|trans }}</a>
          {% endif %}
          <a class="btn btn-l btn-primary" href="{{ 'servicehosting/get_login_url'|api_url(query: { 'order_id':  order.id }) }}" {{ fb_api_link({callback: 'onAfterLoginLinkCreated'}) }}>{{ 'Login to Control Panel'|trans }}</a>
        </div>
      </div>
        
      <div class="row row-cards">
          <div class="col-12 col-lg-4 mb-3 mb-lg-0">
            <div class="card h-100">
              <div class="card-header">
                <div class="d-flex align-items-center justify-content-between w-100">
                  <h3 class="card-title mb-0 d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2l0 -6" /><path d="M8 11v-4a4 4 0 1 1 8 0v4" /><path d="M15 16h.01" /><path d="M12.01 16h.01" /><path d="M9.02 16h.01" /></svg>
                    {{ 'Change Control Panel Password'|trans }}
                  </h3>
                </div>
              </div>

              <div class="card-body">
                <form action="{{ 'servicehosting/change_password'|api_url }}" method="post" {{ fb_api_form({message: 'Password Changed'|trans}) }} class="space-y">
                  <div>
                    <label class="form-label visually-hidden" for="password">{{ 'Password'|trans }}</label>
                    <input type="password" placeholder="{{ 'Password'|trans }}" class="form-control" id="password" name="password" value="{{ request.password }}" required="required" autocomplete="new-password" />
                  </div>
                  <div>
                    <label class="form-label visually-hidden" for="password-confirm">{{ 'Password Confirm'|trans }}</label>
                    <input type="password" placeholder="{{ 'Password Confirm'|trans }}" class="form-control" id="password-confirm" name="password" value="{{ request.password }}" required="required" autocomplete="new-password" />
                  </div>
                  <input type="hidden" name="order_id" value="{{ order.id }}">
                  <div class="mt-1 d-flex justify-content-end"><button type="submit" class="btn btn-outline-primary" value="{{ 'Change Password'|trans }}">{{ 'Change Password'|trans }}</button></div>
                </form>
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-4 mb-3 mb-lg-0">
            <div class="card h-100">
              <div class="card-header">
                <div class="d-flex align-items-center justify-content-between w-100">
                  <h3 class="card-title mb-0 d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M3.6 9h16.8" /><path d="M3.6 15h16.8" /><path d="M11.5 3a17 17 0 0 0 0 18" /><path d="M12.5 3a17 17 0 0 1 0 18" /></svg>
                    {{ 'Change Domain'|trans }}
                  </h3>
                </div>
              </div>

              <div class="card-body">
                <form action="{{ 'servicehosting/change_domain'|api_url }}" method="post" {{ fb_api_form({message: 'Domain Name Changed'|trans}) }} class="space-y">
                  <fieldset>
                    <div class="mb-3">
                      <label class="form-label">{{ 'New Domain'|trans }}:</label>

                      <div class="d-flex gap-2">
                        <input class="form-control flex-grow-1" type="text" name="sld" value="{{ request.domain|default(service.sld) }}" required>

                        <input class="form-control" style="max-width:120px" type="text" name="tld" value="{{ request.domain|default(service.tld) }}" required>
                      </div>
                    </div>
                    <input type="hidden" name="order_id" value="{{ order.id }}">
                    <div class="control-group mt-1">
                      <div class="controls d-flex justify-content-end">
                        <button class="btn btn-outline-primary" type="submit" value="{{ 'Change Domain'|trans }}">{{ 'Change Domain'|trans }}</button>
                      </div>
                    </div>
                  </fieldset>
                </form>
              </div>
            </div>
          </div>
          
          <div class="col-12 col-lg-4">
            <div class="card h-100">
              <div class="card-header">
                <div class="d-flex align-items-center justify-content-between w-100">
                  <h3 class="card-title mb-0 d-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h2.5" /><path d="M17.001 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" /><path d="M19.001 15.5v1.5" /><path d="M19.001 21v1.5" /><path d="M22.032 17.25l-1.299 .75" /><path d="M17.27 20l-1.3 .75" /><path d="M15.97 17.25l1.3 .75" /><path d="M20.733 20l1.3 .75" /></svg>
                    {{ 'Change Username'|trans }}
                  </h3>
                </div>
              </div>

              <div class="card-body">
                <form method="post" action="{{ 'servicehosting/change_username'|api_url }}" {{ fb_api_form({message: 'Username Changed'|trans}) }} class="space-y">
                  <fieldset>
                    <div class="control-group">
                      <label class="col-form-label" >{{ 'Username'|trans }}: </label>
                      <div class="controls">
                        <input class="form-control" type="text" name="username" value="{{ request.username|default(service.username) }}" required="required">
                      </div>
                    </div>

                    <input type="hidden" name="order_id" value="{{ order.id }}">
                    <div class="control-group mt-1">
                      <div class="controls d-flex justify-content-end">
                        <button class="btn btn-outline-primary" type="submit" value="{{ 'Change Username'|trans }}">{{ 'Change Username'|trans }}</button>
                      </div>
                    </div>
                  </fieldset>
                </form>
              </div>
            </div>
          </div>
      </div>
    </div>
</div>

{% block js %}
<script>
    function onAfterLoginLinkCreated(url){
        window.open(url, "_blank");
    }
</script>
{% endblock %}
{% endif %}